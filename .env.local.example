# Copy this file to .env.local and fill in your own values.
# NEVER commit .env.local — it holds your secret keys.

# 1) Anthropic API key — from https://console.anthropic.com/settings/keys (starts with sk-ant-)
ANTHROPIC_API_KEY=sk-ant-...

# 2) Your Shopify store domain — the xxxx.myshopify.com part of your admin URL
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# 3) Shopify custom app credentials
#    Admin → Settings → Apps and sales channels → Develop apps → your app → API credentials
SHOPIFY_CLIENT_ID=...
SHOPIFY_CLIENT_SECRET=shpss_...

# 4) Theme ID of the DUPLICATE theme we build on (the app can list your themes to find it)
SHOPIFY_THEME_ID=

# 5) Optional: ScrapingBee key for bot-protected sites — free trial at https://app.scrapingbee.com
SCRAPINGBEE_API_KEY=
