<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&display=swap" rel="stylesheet">

<style>
  .sdr-manifesto {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_v }}px 1.5rem;
  }

  .sdr-manifesto__inner {
    max-width: 1100px;
    margin: 0 auto;
    text-align: center;
  }

  /* ── Split chip: HOT | COLD ── */
  .sdr-chip {
    display: inline-flex;
    margin-bottom: 22px;
    border: 2px solid {{ section.settings.text_color }};
    border-radius: 999px;
    overflow: hidden;
    font-family: 'Archivo Black', sans-serif;
    font-size: 11px;
    letter-spacing: 0.14em;
  }

  .sdr-chip span {
    padding: 7px 16px;
    color: #FFFFFF;
  }

  .sdr-chip span:first-child { background: {{ section.settings.hot_color }}; }
  .sdr-chip span:last-child  { background: {{ section.settings.cold_color }}; }

  .sdr-manifesto__heading {
    margin: 0 auto 10px;
    max-width: 720px;
    font-family: 'Archivo Black', sans-serif;
    font-weight: 400;
    font-size: clamp(30px, 5vw, 52px);
    line-height: 1.05;
    text-transform: uppercase;
    letter-spacing: -0.01em;
    color: {{ section.settings.text_color }};
  }

  /* gradient underline: ember → ice */
  .sdr-manifesto__rule {
    width: 120px;
    height: 6px;
    margin: 18px auto 18px;
    border-radius: 3px;
    background: linear-gradient(90deg, {{ section.settings.hot_color }}, {{ section.settings.cold_color }});
  }

  .sdr-manifesto__intro {
    margin: 0 auto;
    max-width: 560px;
    font-size: 16px;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    opacity: 0.8;
  }

  /* ── Pillars ── */
  .sdr-manifesto__pillars {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-top: {{ section.settings.pillars_gap_top }}px;
    text-align: left;
  }

  @media (min-width: 768px) {
    .sdr-manifesto__pillars {
      grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 4 }}, 1fr);
    }
  }

  .sdr-pillar {
    background: #FFFFFF;
    border: 2px solid {{ section.settings.text_color }};
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }

  .sdr-pillar__bar {
    height: 10px;
    width: 100%;
  }

  .sdr-pillar--hot  .sdr-pillar__bar { background: {{ section.settings.hot_color }}; }
  .sdr-pillar--cold .sdr-pillar__bar { background: {{ section.settings.cold_color }}; }
  .sdr-pillar--split .sdr-pillar__bar {
    background: linear-gradient(90deg, {{ section.settings.hot_color }} 50%, {{ section.settings.cold_color }} 50%);
  }

  .sdr-pillar__body { padding: 20px 20px 24px; }

  .sdr-pillar__temp {
    display: inline-block;
    font-family: 'Archivo Black', sans-serif;
    font-size: 10px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .sdr-pillar--hot  .sdr-pillar__temp { color: {{ section.settings.hot_color }}; }
  .sdr-pillar--cold .sdr-pillar__temp { color: {{ section.settings.cold_color }}; }
  .sdr-pillar--split .sdr-pillar__temp { color: {{ section.settings.text_color }}; }

  .sdr-pillar__title {
    margin: 0 0 8px;
    font-family: 'Archivo Black', sans-serif;
    font-weight: 400;
    font-size: 20px;
    text-transform: uppercase;
    color: {{ section.settings.text_color }};
  }

  .sdr-pillar__text {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    opacity: 0.8;
  }

  /* ── CTA ── */
  .sdr-manifesto__cta {
    display: inline-block;
    margin-top: 40px;
    padding: 15px 38px;
    font-family: 'Archivo Black', sans-serif;
    font-size: 14px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 999px;
    color: #FFFFFF;
    background: {{ section.settings.text_color }};
    position: relative;
    transition: background 0.25s ease, transform 0.15s ease;
  }

  .sdr-manifesto__cta:hover {
    background: linear-gradient(90deg, {{ section.settings.hot_color }}, {{ section.settings.cold_color }});
    transform: translateY(-2px);
  }
</style>

<div class="sdr-manifesto">
  <div class="sdr-manifesto__inner">

    <div class="sdr-chip" aria-hidden="true"><span>{{ section.settings.chip_hot }}</span><span>{{ section.settings.chip_cold }}</span></div>

    {%- if section.settings.heading != blank -%}
      <h2 class="sdr-manifesto__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    <div class="sdr-manifesto__rule" aria-hidden="true"></div>

    {%- if section.settings.intro != blank -%}
      <p class="sdr-manifesto__intro">{{ section.settings.intro }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="sdr-manifesto__pillars">
        {%- for block in section.blocks -%}
          <div class="sdr-pillar sdr-pillar--{{ block.settings.temp }}" {{ block.shopify_attributes }}>
            <div class="sdr-pillar__bar" aria-hidden="true"></div>
            <div class="sdr-pillar__body">
              <span class="sdr-pillar__temp">
                {%- case block.settings.temp -%}
                  {%- when 'hot' -%}Hot
                  {%- when 'cold' -%}Cold
                  {%- else -%}Hot + Cold
                {%- endcase -%}
              </span>
              {%- if block.settings.title != blank -%}
                <h3 class="sdr-pillar__title">{{ block.settings.title }}</h3>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="sdr-pillar__text">{{ block.settings.text }}</p>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="sdr-manifesto__cta">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "SDR Manifesto",
  "tag": "section",
  "class": "sdr-manifesto-section",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Content" },
    { "type": "text", "id": "chip_hot", "label": "Chip — hot label", "default": "Sweat" },
    { "type": "text", "id": "chip_cold", "label": "Chip — cold label", "default": "Dip" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Round after round" },
    { "type": "textarea", "id": "intro", "label": "Intro text", "default": "Sweat Dip Repeat is for the bench-sitters and barrel-gaspers. One belief on every chest: the good stuff lives on both ends of the thermometer. Nothing good is lukewarm." },
    { "type": "text", "id": "btn_label", "label": "Button label", "default": "Get the Tee" },
    { "type": "url", "id": "btn_link", "label": "Button link" },
    { "type": "header", "content": "Style" },
    { "type": "color", "id": "bg_color", "label": "Background color", "default": "#F7F3EE" },
    { "type": "color", "id": "text_color", "label": "Ink color", "default": "#1C1C1C" },
    { "type": "color", "id": "hot_color", "label": "Hot — ember", "default": "#E4572E" },
    { "type": "color", "id": "cold_color", "label": "Cold — ice", "default": "#7FB6C9" },
    { "type": "range", "id": "padding_v", "label": "Vertical padding", "min": 20, "max": 120, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "pillars_gap_top", "label": "Space above pillars", "min": 20, "max": 80, "step": 4, "unit": "px", "default": 44 }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "select",
          "id": "temp",
          "label": "Temperature",
          "options": [
            { "value": "hot", "label": "Hot" },
            { "value": "cold", "label": "Cold" },
            { "value": "split", "label": "Hot + Cold" }
          ],
          "default": "hot"
        },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "textarea", "id": "text", "label": "Text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "SDR Manifesto — Sweat / Dip / Repeat",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "temp": "hot",
            "title": "Sweat",
            "text": "The bench, the steam, the last thirty seconds you swear you can't do — and do anyway. Leave your excuses at the door with your phone."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "temp": "cold",
            "title": "Dip",
            "text": "The gasp is the whole point. Ten seconds of regret, then the best you'll feel all week. The barrel doesn't negotiate."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "temp": "split",
            "title": "Repeat",
            "text": "The Split Badge finds the others — the red-cheeked, wet-haired, grinning ones. The nod happens automatically. Round after round."
          }
        }
      ]
    }
  ]
}
{% endschema %}
