{%- comment -%}
  Home Hero — Útulno homepage: brand promise + dual hero-product cards + trust strip.
  Positioning: effortless home & garden — smart helpers do the boring work.
  Brand name, colours, copy and the two products are all editable in the theme editor.
{%- endcomment -%}

<style>
  .uhh {
    --uhh-bg: {{ section.settings.bg_color }};
    --uhh-ink: {{ section.settings.ink_color }};
    --uhh-brand: {{ section.settings.brand_color }};
    --uhh-accent: {{ section.settings.accent_color }};
    --uhh-surface: {{ section.settings.surface_color }};
    background: var(--uhh-bg);
    color: var(--uhh-ink);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
  }
  .uhh__top { max-width: 1180px; margin: 0 auto; padding: 54px 1.5rem 30px; text-align: center; }
  .uhh__brand {
    font-family: Georgia, "Iowan Old Style", serif; font-weight: 700;
    font-size: 30px; color: var(--uhh-brand); letter-spacing: -.01em; margin: 0 0 4px;
  }
  .uhh__brand .dot { color: var(--uhh-accent); }
  .uhh__eyebrow {
    font-size: 12px; font-weight: 700; letter-spacing: .14em; text-transform: uppercase;
    color: var(--uhh-accent); margin: 0 0 14px;
  }
  .uhh__headline {
    font-size: 34px; line-height: 1.12; font-weight: 900; letter-spacing: -.6px;
    margin: 0 auto 14px; max-width: 18ch;
  }
  @media (min-width: 760px) { .uhh__headline { font-size: 48px; } }
  .uhh__sub { font-size: 17px; color: var(--uhh-ink); opacity: .8; max-width: 56ch; margin: 0 auto; }

  /* product cards */
  .uhh__grid {
    max-width: 1180px; margin: 0 auto; padding: 8px 1.5rem 20px;
    display: grid; grid-template-columns: 1fr; gap: 20px;
  }
  @media (min-width: 780px) { .uhh__grid { grid-template-columns: 1fr 1fr; } }

  .uhh__card {
    background: var(--uhh-surface); border: 1px solid rgba(0,0,0,.08);
    border-radius: 20px; overflow: hidden; display: flex; flex-direction: column;
  }
  .uhh__media {
    aspect-ratio: 16/10; background: linear-gradient(160deg,#dfe7df,#c7d3c4);
    position: relative; display: flex; align-items: center; justify-content: center;
  }
  .uhh__media img { width: 100%; height: 100%; object-fit: cover; }
  .uhh__tag {
    position: absolute; top: 14px; left: 14px; background: var(--uhh-accent); color: #fff;
    font-size: 11px; font-weight: 800; letter-spacing: .06em; text-transform: uppercase;
    padding: 6px 11px; border-radius: 999px;
  }
  .uhh__body { padding: 22px 22px 24px; display: flex; flex-direction: column; flex: 1; }
  .uhh__cat { font-size: 12px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; color: var(--uhh-brand); }
  .uhh__name { font-size: 23px; font-weight: 800; letter-spacing: -.3px; margin: 6px 0 4px; }
  .uhh__hook { font-size: 15px; color: var(--uhh-ink); opacity: .78; margin: 0 0 14px; }
  .uhh__stars { color: var(--uhh-accent); font-size: 15px; letter-spacing: 2px; }
  .uhh__rate { font-size: 12.5px; color: var(--uhh-ink); opacity: .65; margin: 0 0 14px; }
  .uhh__price { display: flex; align-items: baseline; gap: 10px; margin: 0 0 16px; }
  .uhh__now { font-size: 26px; font-weight: 900; letter-spacing: -.4px; }
  .uhh__was { font-size: 15px; opacity: .5; text-decoration: line-through; }
  .uhh__cta {
    margin-top: auto; display: block; text-align: center; text-decoration: none;
    background: var(--uhh-brand); color: #fff; font-size: 16px; font-weight: 800;
    padding: 14px; border-radius: 12px;
  }
  .uhh__cta:hover { filter: brightness(1.07); }

  /* trust strip */
  .uhh__trust {
    max-width: 1180px; margin: 0 auto; padding: 8px 1.5rem 54px;
    display: grid; grid-template-columns: 1fr 1fr; gap: 4px 20px;
  }
  @media (min-width: 640px) { .uhh__trust { grid-template-columns: repeat(4, 1fr); } }
  .uhh__ti { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; padding: 10px 0; }
  .uhh__ti svg { width: 18px; height: 18px; color: var(--uhh-brand); flex: 0 0 auto; }
</style>

<section class="uhh">
  <div class="uhh__top">
    {%- if section.settings.brand_name != blank -%}
      <p class="uhh__brand">{{ section.settings.brand_name }}<span class="dot">.</span></p>
    {%- endif -%}
    {%- if section.settings.eyebrow != blank -%}
      <p class="uhh__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    <h1 class="uhh__headline">{{ section.settings.headline }}</h1>
    {%- if section.settings.subhead != blank -%}
      <p class="uhh__sub">{{ section.settings.subhead }}</p>
    {%- endif -%}
  </div>

  <div class="uhh__grid">
    {%- for block in section.blocks -%}
      {%- if block.type == 'product' -%}
        <article class="uhh__card" {{ block.shopify_attributes }}>
          <div class="uhh__media">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 900 }}" alt="{{ block.settings.name | escape }}" loading="lazy">
            {%- endif -%}
            {%- if block.settings.tag != blank -%}<span class="uhh__tag">{{ block.settings.tag }}</span>{%- endif -%}
          </div>
          <div class="uhh__body">
            <span class="uhh__cat">{{ block.settings.category }}</span>
            <h2 class="uhh__name">{{ block.settings.name }}</h2>
            <p class="uhh__hook">{{ block.settings.hook }}</p>
            <div class="uhh__stars">★★★★★</div>
            <p class="uhh__rate">{{ block.settings.rating }}</p>
            <div class="uhh__price">
              <span class="uhh__now">{{ block.settings.price }}</span>
              {%- if block.settings.compare != blank -%}<span class="uhh__was">{{ block.settings.compare }}</span>{%- endif -%}
            </div>
            <a class="uhh__cta" href="{{ block.settings.link | default: '#' }}">{{ block.settings.cta | default: 'Koupit' }}</a>
          </div>
        </article>
      {%- endif -%}
    {%- endfor -%}
  </div>

  <div class="uhh__trust">
    {%- for block in section.blocks -%}
      {%- if block.type == 'trust' -%}
        <div class="uhh__ti" {{ block.shopify_attributes }}>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
          <span>{{ block.settings.label }}</span>
        </div>
      {%- endif -%}
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "Home Hero (Útulno)",
  "tag": "section",
  "class": "section-home-hero",
  "settings": [
    { "type": "header", "content": "Barvy" },
