        { "type": "text", "id": "name", "label": "Název", "default": "MOVA ViAX 500" },
        { "type": "text", "id": "hook", "label": "Benefit", "default": "Robotická sekačka bez drátu. Poseká trávník za vás." },
        { "type": "text", "id": "rating", "label": "Hodnocení", "default": "Nejprodávanější bezdrátová sekačka · Ověřeno zákazníky" },
        { "type": "text", "id": "price", "label": "Cena", "default": "14 990 Kč" },
        { "type": "text", "id": "compare", "label": "Původní cena", "default": "17 990 Kč" },
        { "type": "text", "id": "cta", "label": "Tlačítko", "default": "Prohlédnout sekačku" },
        { "type": "url", "id": "link", "label": "Odkaz" }
      ]
    },
    {
      "type": "trust",
      "name": "Prvek důvěry",
      "settings": [
        { "type": "text", "id": "label", "label": "Text", "default": "Doprava Zásilkovnou zdarma" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Home Hero (Útulno)",
      "blocks": [
        { "type": "product", "settings": {
          "category": "Zahrada", "tag": "Bestseller · Jaro–léto",
          "name": "MOVA ViAX 500",
          "hook": "Robotická sekačka bez drátu. Poseká trávník za vás — i na chatě.",
          "rating": "Nejprodávanější bezdrátová sekačka · Ověřeno zákazníky",
          "price": "14 990 Kč", "compare": "17 990 Kč", "cta": "Prohlédnout sekačku" } },
        { "type": "product", "settings": {
          "category": "Domov", "tag": "Bestseller · Celoročně",
          "name": "Roborock Qrevo S Pro",
          "hook": "Robotický vysavač s mopem. Vysaje i vytře. Úplně sám.",
          "rating": "Nejžádanější robotický vysavač roku · Ověřeno zákazníky",
          "price": "15 490 Kč", "compare": "18 990 Kč", "cta": "Prohlédnout vysavač" } },
        { "type": "trust", "settings": { "label": "Doprava Zásilkovnou zdarma nad 1 500 Kč" } },
        { "type": "trust", "settings": { "label": "Platba dobírkou i kartou" } },
        { "type": "trust", "settings": { "label": "14 dní na vrácení · 24 měsíců záruka" } },
        { "type": "trust", "settings": { "label": "Ověřeno zákazníky · český servis" } }
