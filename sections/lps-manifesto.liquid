<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Shrikhand&display=swap" rel="stylesheet">

<style>
  .lps-manifesto {
    background-color: {{ section.settings.bg_color }};
    padding: {{ section.settings.padding_v }}px 0;
    overflow: hidden;
  }

  /* ── Marquee strip ── */
  .lps-marquee {
    background: {{ section.settings.accent2_color }};
    color: {{ section.settings.text_color }};
    transform: rotate(-1.2deg) scale(1.02);
    padding: 10px 0;
    margin-bottom: 56px;
    border-top: 3px solid {{ section.settings.text_color }};
    border-bottom: 3px solid {{ section.settings.text_color }};
    white-space: nowrap;
    display: flex;
  }

  .lps-marquee__track {
    display: inline-flex;
    gap: 0;
    animation: lps-scroll 22s linear infinite;
  }

  .lps-marquee__item {
    font-family: 'Shrikhand', cursive;
    font-size: 15px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    padding-right: 28px;
  }

  @keyframes lps-scroll {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }

  @media (prefers-reduced-motion: reduce) {
    .lps-marquee__track { animation: none; }
  }

  .lps-manifesto__inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 1.5rem;
    text-align: center;
    position: relative;
  }

  /* ── Spinning record ── */
  .lps-record {
    width: 84px;
    height: 84px;
    margin: 0 auto 20px;
    border-radius: 50%;
    background:
      radial-gradient(circle at center,
        {{ section.settings.accent_color }} 0 14px,
        {{ section.settings.text_color }} 15px 20px,
        transparent 21px 23px,
        {{ section.settings.text_color }} 24px 27px,
        transparent 28px 30px,
        {{ section.settings.text_color }} 31px 100%);
    animation: lps-spin 9s linear infinite;
  }

  @keyframes lps-spin { to { transform: rotate(360deg); } }

  @media (prefers-reduced-motion: reduce) {
    .lps-record { animation: none; }
  }

  .lps-manifesto__heading {
    margin: 0 auto 16px;
    max-width: 700px;
    font-family: 'Shrikhand', cursive;
    font-weight: 400;
    font-size: clamp(34px, 5.5vw, 58px);
    line-height: 1.05;
    color: {{ section.settings.text_color }};
    text-shadow: 3px 3px 0 {{ section.settings.accent_color }};
  }

  .lps-manifesto__intro {
    margin: 0 auto;
    max-width: 540px;
    font-size: 16px;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    opacity: 0.85;
  }

  /* ── Pillar stickers ── */
  .lps-manifesto__pillars {
    display: grid;
    grid-template-columns: 1fr;
    gap: 26px;
    margin-top: {{ section.settings.pillars_gap_top }}px;
    text-align: left;
  }

  @media (min-width: 768px) {
    .lps-manifesto__pillars {
      grid-template-columns: repeat({{ section.blocks.size | at_least: 1 | at_most: 4 }}, 1fr);
      gap: 28px;
    }
  }

  .lps-pillar {
    background: #FFFFFF;
    border: 3px solid {{ section.settings.text_color }};
    border-radius: 18px;
    padding: 22px 20px 24px;
    box-shadow: 6px 6px 0 {{ section.settings.text_color }};
    transition: transform 0.18s ease, box-shadow 0.18s ease;
  }

  .lps-pillar:nth-child(3n+1) { transform: rotate(-1.4deg); }
  .lps-pillar:nth-child(3n+2) { transform: rotate(1.2deg);  background: {{ section.settings.accent2_color }}33; }
  .lps-pillar:nth-child(3n)   { transform: rotate(-0.8deg); background: {{ section.settings.accent_color }}22; }

  .lps-pillar:hover {
    transform: rotate(0deg) translate(-2px, -2px);
    box-shadow: 9px 9px 0 {{ section.settings.text_color }};
  }

  .lps-pillar__index {
    display: inline-block;
    font-family: 'Shrikhand', cursive;
    font-size: 26px;
    line-height: 1;
    color: {{ section.settings.accent_color }};
    -webkit-text-stroke: 1px {{ section.settings.text_color }};
    margin-bottom: 10px;
  }

  .lps-pillar__title {
    margin: 0 0 8px;
    font-family: 'Shrikhand', cursive;
    font-weight: 400;
    font-size: 21px;
    color: {{ section.settings.text_color }};
  }

  .lps-pillar__text {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.6;
    color: {{ section.settings.text_color }};
    opacity: 0.85;
  }

  /* ── CTA ── */
  .lps-manifesto__cta {
    display: inline-block;
    margin-top: 44px;
    padding: 15px 36px;
    font-family: 'Shrikhand', cursive;
    font-size: 17px;
    letter-spacing: 0.04em;
    text-decoration: none;
    border-radius: 999px;
    background-color: {{ section.settings.accent_color }};
    color: #FFFFFF;
    border: 3px solid {{ section.settings.text_color }};
    box-shadow: 5px 5px 0 {{ section.settings.text_color }};
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .lps-manifesto__cta:hover {
    transform: translate(-2px, -2px) rotate(-1deg);
    box-shadow: 8px 8px 0 {{ section.settings.text_color }};
  }
</style>

<div class="lps-manifesto">

  {%- if section.settings.marquee_text != blank -%}
    <div class="lps-marquee" aria-hidden="true">
      <div class="lps-marquee__track">
        {%- for i in (1..8) -%}
          <span class="lps-marquee__item">{{ section.settings.marquee_text }}</span>
        {%- endfor -%}
      </div>
    </div>
  {%- endif -%}

  <div class="lps-manifesto__inner">

    {%- if section.settings.show_record -%}
      <div class="lps-record" aria-hidden="true"></div>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="lps-manifesto__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.intro != blank -%}
      <p class="lps-manifesto__intro">{{ section.settings.intro }}</p>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="lps-manifesto__pillars">
        {%- for block in section.blocks -%}
          <div class="lps-pillar" {{ block.shopify_attributes }}>
            <span class="lps-pillar__index">{{ forloop.index | prepend: '0' }}</span>
            {%- if block.settings.title != blank -%}
              <h3 class="lps-pillar__title">{{ block.settings.title }}</h3>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="lps-pillar__text">{{ block.settings.text }}</p>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="lps-manifesto__cta">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}

  </div>
</div>

{% schema %}
{
  "name": "LPS Manifesto",
  "tag": "section",
  "class": "lps-manifesto-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "marquee_text",
      "label": "Marquee text",
      "default": "Play it all the way through ★ No skips ★ Both sides ★ 33⅓ forever ★"
    },
    {
      "type": "checkbox",
      "id": "show_record",
      "label": "Show spinning record",
      "default": true
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Kiss your shuffle goodbye."
    },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Long Play Society is for the flippers, the crate diggers, the B-side believers. One belief, stitched on every chest: an album is a whole thing. Let it cook."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button label",
      "default": "Grab the Tee"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background color",
      "default": "#F6EEDD"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Ink color",
      "default": "#24160F"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent — orange",
      "default": "#F25C05"
    },
    {
      "type": "color",
      "id": "accent2_color",
      "label": "Accent — mustard",
      "default": "#E8A33D"
    },
    {
      "type": "range",
      "id": "padding_v",
      "label": "Vertical padding",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "pillars_gap_top",
      "label": "Space above pillars",
      "min": 20,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "pillar",
      "name": "Pillar",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "LPS Manifesto — Drop It / Flip It / Wear It",
      "blocks": [
        {
          "type": "pillar",
          "settings": {
            "title": "Drop It",
            "text": "Needle down, phone down, volume up. Forty minutes where the record gets your whole attention — and gives it right back."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Flip It",
            "text": "Side A in full. Then the flip — that little walk to the turntable is the best intermission in music. The deep cuts live on Side B."
          }
        },
        {
          "type": "pillar",
          "settings": {
            "title": "Wear It",
            "text": "The Label on your chest does the talking. Other members will clock it across the record shop. Nod accordingly."
          }
        }
      ]
    }
  ]
}
{% endschema %}
