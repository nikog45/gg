        },
        {
          "type": "text",
          "id": "author",
          "label": "Nome autore",
          "default": "Mario R."
        },
        {
          "type": "text",
          "id": "date",
          "label": "Data",
          "default": "2 giorni fa"
        }
      ]
    }
  ],
  "presets": [
    {
