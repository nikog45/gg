{%- comment -%}
  Product Reviews section for Unieuro (unieuroo.com)
  - Auto-detects the current product by handle and shows its reviews.
  - Summary count + star distribution are generated deterministically per product
    (~92% 5-star => ~4.9 average) so each product page looks full and consistent.
  - Add this section to your product template once; no per-product setup required.
{%- endcomment -%}

<style>
  .uni-rev {
    --uni-accent: {{ section.settings.accent_color }};
    --uni-star: {{ section.settings.star_color }};
    --uni-text: #1f2328;
    --uni-muted: #6b7280;
    --uni-border: #e6e8eb;
    --uni-bg-bar: #eef0f2;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ section.settings.padding_v }}px {{ section.settings.padding_h }}px;
    color: var(--uni-text);
    font-family: inherit;
  }
  .uni-rev *, .uni-rev *::before, .uni-rev *::after { box-sizing: border-box; }

  .uni-rev__layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }
  @media (min-width: 900px) {
    .uni-rev__layout { grid-template-columns: 260px 1fr; gap: 48px; align-items: start; }
    .uni-rev__summary { position: sticky; top: 24px; }
  }

  /* ── Summary column ── */
  .uni-rev__score {
    font-size: 58px;
    font-weight: 800;
    line-height: 1;
    letter-spacing: -1px;
  }
  .uni-rev__summary-stars { margin: 6px 0 4px; }
  .uni-rev__summary-sub { font-size: 13px; color: var(--uni-muted); }

  .uni-rev__bars { margin-top: 18px; display: flex; flex-direction: column; gap: 7px; }
  .uni-rev__bar-row { display: flex; align-items: center; gap: 8px; font-size: 13px; }
  .uni-rev__bar-label { width: 10px; text-align: right; color: var(--uni-muted); font-weight: 600; }
  .uni-rev__bar-star { width: 12px; height: 12px; flex: 0 0 auto; }
  .uni-rev__bar-track { position: relative; flex: 1; height: 8px; border-radius: 999px; background: var(--uni-bg-bar); overflow: hidden; }
  .uni-rev__bar-fill { position: absolute; inset: 0 auto 0 0; background: #111; border-radius: 999px; width: 0; transition: width .6s ease; }
  .uni-rev__bar-count { width: 34px; text-align: right; color: var(--uni-muted); font-variant-numeric: tabular-nums; }

  /* ── Reviews column header ── */
  .uni-rev__tab {
    font-size: 20px;
    font-weight: 700;
    padding-bottom: 12px;
    border-bottom: 2px solid var(--uni-text);
    display: inline-block;
    margin: 0 0 20px;
  }
  .uni-rev__toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 24px;
  }
  .uni-rev__search {
    position: relative;
    flex: 1 1 240px;
    min-width: 200px;
  }
  .uni-rev__search input {
    width: 100%;
    height: 42px;
    padding: 0 14px 0 40px;
    border: 1px solid var(--uni-border);
    border-radius: 8px;
    font-size: 14px;
    color: var(--uni-text);
    background: #fff;
  }
  .uni-rev__search input:focus { outline: none; border-color: var(--uni-accent); }
  .uni-rev__search svg { position: absolute; left: 13px; top: 50%; transform: translateY(-50%); width: 16px; height: 16px; color: var(--uni-muted); }

  .uni-rev__write {
    height: 42px;
    padding: 0 22px;
    background: var(--uni-accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    white-space: nowrap;
    transition: filter .15s ease;
  }
  .uni-rev__write:hover { filter: brightness(0.94); }

  .uni-rev__sort {
    height: 42px;
    padding: 0 12px;
    border: 1px solid var(--uni-border);
    border-radius: 8px;
    font-size: 13px;
    color: var(--uni-text);
    background: #fff;
    cursor: pointer;
  }

  /* ── Review card ── */
  .uni-rev__list { display: flex; flex-direction: column; gap: 16px; }
  .uni-rev__card {
    border: 1px solid var(--uni-border);
    border-radius: 12px;
    padding: 20px 22px;
    background: #fff;
  }
  .uni-rev__card-top { display: flex; justify-content: space-between; gap: 12px; align-items: flex-start; }
  .uni-rev__id { display: flex; gap: 12px; align-items: center; }
  .uni-rev__avatar {
    width: 40px; height: 40px; border-radius: 50%;
    display: grid; place-items: center;
    color: #fff; font-weight: 700; font-size: 15px; flex: 0 0 auto;
  }
  .uni-rev__name-line { display: flex; align-items: center; gap: 7px; font-weight: 700; font-size: 15px; }
  .uni-rev__flag { font-size: 14px; line-height: 1; }
  .uni-rev__date { font-size: 12px; color: var(--uni-muted); margin-top: 2px; }
  .uni-rev__rating { text-align: right; flex: 0 0 auto; }
  .uni-rev__rating-label { font-size: 11px; color: var(--uni-muted); display: block; margin-bottom: 3px; }
  .uni-rev__verified {
    display: inline-flex; align-items: center; gap: 4px;
    margin-top: 12px;
    font-size: 12px; font-weight: 600; color: #1a7f37;
  }
  .uni-rev__verified svg { width: 14px; height: 14px; }
  .uni-rev__text { margin: 12px 0 0; font-size: 14.5px; line-height: 1.55; color: #3a3f45; }

  .uni-rev__stars { display: inline-flex; gap: 2px; }
  .uni-rev__stars svg { width: 15px; height: 15px; }
  .uni-rev__summary-stars svg { width: 18px; height: 18px; }

  .uni-rev__more {
    margin: 24px auto 0;
    display: block;
    padding: 12px 26px;
    background: transparent;
    color: var(--uni-text);
    border: 1px solid var(--uni-text);
    border-radius: 8px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: background .15s ease, color .15s ease;
  }
  .uni-rev__more:hover { background: var(--uni-text); color: #fff; }
  .uni-rev__empty { padding: 32px 0; text-align: center; color: var(--uni-muted); font-size: 14px; }

  /* ── Modal ── */
  .uni-rev__modal { position: fixed; inset: 0; z-index: 9999; display: none; }
  .uni-rev__modal.is-open { display: block; }
  .uni-rev__modal-bg { position: absolute; inset: 0; background: rgba(17,19,24,.55); }
  .uni-rev__modal-box {
    position: absolute; left: 50%; top: 50%; transform: translate(-50%,-50%);
    width: min(520px, calc(100vw - 32px)); max-height: calc(100vh - 40px); overflow: auto;
    background: #fff; border-radius: 14px; padding: 26px;
  }
  .uni-rev__modal-title { font-size: 19px; font-weight: 800; margin: 0 0 4px; }
  .uni-rev__modal-sub { font-size: 13px; color: var(--uni-muted); margin: 0 0 18px; }
  .uni-rev__field { margin-bottom: 14px; }
  .uni-rev__field label { display: block; font-size: 13px; font-weight: 600; margin-bottom: 6px; }
  .uni-rev__field input, .uni-rev__field textarea {
    width: 100%; border: 1px solid var(--uni-border); border-radius: 8px;
    padding: 10px 12px; font-size: 14px; font-family: inherit; color: var(--uni-text);
  }
  .uni-rev__field input:focus, .uni-rev__field textarea:focus { outline: none; border-color: var(--uni-accent); }
  .uni-rev__field textarea { min-height: 96px; resize: vertical; }
  .uni-rev__rate-pick { display: inline-flex; gap: 4px; cursor: pointer; }
  .uni-rev__rate-pick svg { width: 26px; height: 26px; }
  .uni-rev__modal-actions { display: flex; gap: 10px; justify-content: flex-end; margin-top: 8px; }
  .uni-rev__btn-ghost, .uni-rev__btn-solid {
    height: 42px; padding: 0 20px; border-radius: 8px; font-size: 14px; font-weight: 700; cursor: pointer;
  }
  .uni-rev__btn-ghost { background: #fff; border: 1px solid var(--uni-border); color: var(--uni-text); }
  .uni-rev__btn-solid { background: var(--uni-accent); color: #fff; border: none; }

  .uni-rev__toast {
    position: fixed; left: 50%; bottom: 28px; transform: translateX(-50%) translateY(20px);
    background: #111; color: #fff; padding: 13px 20px; border-radius: 10px; font-size: 14px;
    opacity: 0; pointer-events: none; transition: opacity .25s ease, transform .25s ease; z-index: 10000;
  }
  .uni-rev__toast.is-show { opacity: 1; transform: translateX(-50%) translateY(0); }
</style>

<section
  class="uni-rev"
  id="uni-rev-{{ section.id }}"
  data-handle="{{ product.handle }}"
  data-seed="{{ product.id | default: 0 }}"
  data-per-page="{{ section.settings.reviews_per_page }}"
  data-enable-write="{{ section.settings.enable_write_review }}"
  data-enable-search="{{ section.settings.enable_search }}">

  {%- if section.settings.heading != blank -%}
    <h2 class="uni-rev__section-heading" style="font-size:22px;font-weight:800;margin:0 0 24px;">{{ section.settings.heading }}</h2>
  {%- endif -%}

  <div class="uni-rev__layout">
    <aside class="uni-rev__summary">
      <div class="uni-rev__score" data-role="avg">0.0</div>
      <div class="uni-rev__summary-stars" data-role="summary-stars"></div>
      <div class="uni-rev__summary-sub">Basato su <span data-role="total">0</span> recensioni</div>
      <div class="uni-rev__bars" data-role="bars"></div>
    </aside>

    <div class="uni-rev__reviews">
      <h3 class="uni-rev__tab">Recensioni (<span data-role="tab-count">0</span>)</h3>

      <div class="uni-rev__toolbar">
        {%- if section.settings.enable_search -%}
          <div class="uni-rev__search">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
            <input type="search" data-role="search" placeholder="Cerca tra le recensioni" aria-label="Cerca tra le recensioni">
          </div>
        {%- endif -%}
        <select class="uni-rev__sort" data-role="sort" aria-label="Ordina recensioni">
          <option value="recent">Più recenti</option>
          <option value="old">Meno recenti</option>
        </select>
        {%- if section.settings.enable_write_review -%}
          <button type="button" class="uni-rev__write" data-role="open-modal">Scrivi una recensione</button>
        {%- endif -%}
      </div>

      <div class="uni-rev__list" data-role="list"></div>
      <button type="button" class="uni-rev__more" data-role="more" hidden>Mostra altre recensioni</button>
    </div>
  </div>

  {%- if section.settings.enable_write_review -%}
    <div class="uni-rev__modal" data-role="modal" aria-hidden="true" role="dialog" aria-modal="true">
      <div class="uni-rev__modal-bg" data-role="close-modal"></div>
      <div class="uni-rev__modal-box">
        <h3 class="uni-rev__modal-title">Scrivi una recensione</h3>
        <p class="uni-rev__modal-sub">Condividi la tua esperienza con questo prodotto.</p>
        <form data-role="review-form">
          <div class="uni-rev__field">
            <label>Valutazione</label>
            <span class="uni-rev__rate-pick" data-role="rate-pick"></span>
          </div>
          <div class="uni-rev__field">
            <label for="uni-rev-name-{{ section.id }}">Nome</label>
            <input id="uni-rev-name-{{ section.id }}" type="text" name="name" required maxlength="60" placeholder="Il tuo nome">
          </div>
          <div class="uni-rev__field">
            <label for="uni-rev-text-{{ section.id }}">Recensione</label>
            <textarea id="uni-rev-text-{{ section.id }}" name="text" required maxlength="600" placeholder="Cosa ti è piaciuto del prodotto?"></textarea>
          </div>
          <div class="uni-rev__modal-actions">
            <button type="button" class="uni-rev__btn-ghost" data-role="close-modal">Annulla</button>
            <button type="submit" class="uni-rev__btn-solid">Invia recensione</button>
          </div>
        </form>
      </div>
    </div>
  {%- endif -%}

  <div class="uni-rev__toast" data-role="toast"></div>

  <script type="application/json" data-role="reviews-data">
{{ section.settings.reviews_json | default: '' }}
{% raw %}__UNI_REVIEWS_DATA__{% endraw %}
  </script>
</section>

