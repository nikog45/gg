  var AVATAR_COLORS = ['#e8833a','#3a7bd5','#8e44ad','#16a085','#c0392b','#2c3e50','#d35400','#27ae60','#7f8c8d','#2980b9'];

  function starSVG(filled) {
    var fill = filled ? 'var(--uni-star)' : '#d9dce0';
    return '<svg viewBox="0 0 24 24" fill="' + fill + '" aria-hidden="true"><path d="M12 2l2.9 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 7.1-1.01L12 2z"/></svg>';
  }
  function stars(n, max) {
    max = max || 5;
    var s = '';
    for (var i = 1; i <= max; i++) s += starSVG(i <= n);
    return '<span class="uni-rev__stars">' + s + '</span>';
  }
  function initials(name) {
    var parts = name.trim().split(/\s+/);
    var a = (parts[0] || '')[0] || '';
    var b = (parts[1] || '')[0] || '';
    return (a + b).toUpperCase();
  }
  function colorFor(name) {
    var sum = 0;
    for (var i = 0; i < name.length; i++) sum += name.charCodeAt(i);
    return AVATAR_COLORS[sum % AVATAR_COLORS.length];
  }
  function parseDate(d) {
    var p = d.split('/');
    return new Date(+p[2], +p[1] - 1, +p[0]).getTime();
  }
  function esc(s) {
    return String(s).replace(/[&<>"']/g, function (c) {
      return { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;' }[c];
    });
  }

  // Deterministic aggregate summary per product (~92% 5-star => ~4.9 avg).
  function summaryFor(seed, realCount) {
    seed = Math.abs(parseInt(seed, 10) || 0);
    var total = 168 + (seed % 97); // 168..264
    if (total < realCount) total = realCount + 140;
    var five = Math.round(total * 0.92);
    var four = Math.round(total * 0.065);
    var three = Math.max(0, total - five - four);
    var dist = [five, four, three, 0, 0];
    var avg = (5 * five + 4 * four + 3 * three) / total;
    return { total: total, dist: dist, avg: avg };
  }

  function initSection(root) {
    var handle = root.getAttribute('data-handle') || '';
    var seed = root.getAttribute('data-seed') || '0';
    var perPage = parseInt(root.getAttribute('data-per-page'), 10) || 8;
    var enableWrite = root.getAttribute('data-enable-write') === 'true';

    // Prefer inline JSON override, else fall back to the bundled dataset.
    var dataMap = DATA;
    var jsonEl = root.querySelector('[data-role="reviews-data"]');
    if (jsonEl) {
      var raw = jsonEl.textContent.replace('__UNI_REVIEWS_DATA__', '').trim();
      if (raw) { try { dataMap = JSON.parse(raw); } catch (e) {} }
    }

    var reviews = (dataMap[handle] || []).slice();
    if (!reviews.length) {
      // Theme-editor / non-product context: preview with the first product.
      var firstKey = Object.keys(dataMap)[0];
      reviews = firstKey ? dataMap[firstKey].slice() : [];
    }
    reviews.forEach(function (r) { r.r = r.r || 5; r._ts = parseDate(r.d); });

    var summary = summaryFor(seed, reviews.length);

    // ── Summary column ──
    root.querySelector('[data-role="avg"]').textContent = summary.avg.toFixed(1);
    root.querySelector('[data-role="total"]').textContent = summary.total;
    root.querySelector('[data-role="summary-stars"]').innerHTML = stars(Math.round(summary.avg));

    var barsEl = root.querySelector('[data-role="bars"]');
    var barsHTML = '';
    for (var s = 5; s >= 1; s--) {
      var count = summary.dist[5 - s];
      var pct = summary.total ? (count / summary.total * 100) : 0;
      barsHTML +=
        '<div class="uni-rev__bar-row">' +
          '<span class="uni-rev__bar-label">' + s + '</span>' +
          '<svg class="uni-rev__bar-star" viewBox="0 0 24 24" fill="var(--uni-star)"><path d="M12 2l2.9 6.26L22 9.27l-5 4.87L18.18 22 12 18.56 5.82 22 7 14.14l-5-4.87 7.1-1.01L12 2z"/></svg>' +
          '<span class="uni-rev__bar-track"><span class="uni-rev__bar-fill" data-pct="' + pct + '"></span></span>' +
          '<span class="uni-rev__bar-count">' + count + '</span>' +
        '</div>';
    }
    barsEl.innerHTML = barsHTML;
    requestAnimationFrame(function () {
      barsEl.querySelectorAll('.uni-rev__bar-fill').forEach(function (f) {
        f.style.width = f.getAttribute('data-pct') + '%';
      });
    });

    root.querySelector('[data-role="tab-count"]').textContent = summary.total;

    // ── List rendering ──
    var listEl = root.querySelector('[data-role="list"]');
    var moreBtn = root.querySelector('[data-role="more"]');
    var searchEl = root.querySelector('[data-role="search"]');
    var sortEl = root.querySelector('[data-role="sort"]');
    var shown = perPage;

    function cardHTML(r) {
      return (
        '<article class="uni-rev__card">' +
          '<div class="uni-rev__card-top">' +
            '<div class="uni-rev__id">' +
              '<span class="uni-rev__avatar" style="background:' + colorFor(r.n) + '">' + esc(initials(r.n)) + '</span>' +
              '<div>' +
                '<div class="uni-rev__name-line">' + esc(r.n) + ' <span class="uni-rev__flag">🇮🇹</span></div>' +
                '<div class="uni-rev__date">' + esc(r.d) + '</div>' +
              '</div>' +
            '</div>' +
            '<div class="uni-rev__rating">' +
              '<span class="uni-rev__rating-label">Valutazione: ' + r.r + '/5</span>' +
              stars(r.r) +
            '</div>' +
          '</div>' +
          '<span class="uni-rev__verified">' +
            '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4"><path d="M20 6 9 17l-5-5"/></svg>' +
            'Acquisto verificato</span>' +
          '<p class="uni-rev__text">' + esc(r.t) + '</p>' +
        '</article>'
      );
    }

    function currentFiltered() {
      var q = (searchEl && searchEl.value || '').trim().toLowerCase();
      var arr = reviews.filter(function (r) {
        return !q || r.t.toLowerCase().indexOf(q) !== -1 || r.n.toLowerCase().indexOf(q) !== -1;
      });
      var dir = sortEl && sortEl.value === 'old' ? 1 : -1;
      arr.sort(function (a, b) { return (a._ts - b._ts) * dir; });
      return arr;
    }

    function render() {
      var arr = currentFiltered();
      if (!arr.length) {
        listEl.innerHTML = '<div class="uni-rev__empty">Nessuna recensione trovata.</div>';
        moreBtn.hidden = true;
        return;
      }
      listEl.innerHTML = arr.slice(0, shown).map(cardHTML).join('');
      moreBtn.hidden = shown >= arr.length;
    }

    moreBtn.addEventListener('click', function () { shown += perPage; render(); });
    if (searchEl) searchEl.addEventListener('input', function () { shown = perPage; render(); });
    if (sortEl) sortEl.addEventListener('change', function () { shown = perPage; render(); });
    render();

    // ── Write-review modal ──
    if (enableWrite) {
      var modal = root.querySelector('[data-role="modal"]');
      var openBtn = root.querySelector('[data-role="open-modal"]');
      var form = root.querySelector('[data-role="review-form"]');
      var ratePick = root.querySelector('[data-role="rate-pick"]');
      var toast = root.querySelector('[data-role="toast"]');
      var chosen = 5;

      function drawPicker() {
        var html = '';
        for (var i = 1; i <= 5; i++) {
          html += '<span data-val="' + i + '">' + starSVG(i <= chosen) + '</span>';
        }
        ratePick.innerHTML = html;
      }
      drawPicker();
      ratePick.addEventListener('click', function (e) {
        var t = e.target.closest('[data-val]');
        if (!t) return;
        chosen = +t.getAttribute('data-val');
        drawPicker();
      });

      function openModal() { modal.classList.add('is-open'); modal.setAttribute('aria-hidden', 'false'); }
      function closeModal() { modal.classList.remove('is-open'); modal.setAttribute('aria-hidden', 'true'); }
      if (openBtn) openBtn.addEventListener('click', openModal);
      root.querySelectorAll('[data-role="close-modal"]').forEach(function (b) {
        b.addEventListener('click', closeModal);
      });
      document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeModal(); });

      function showToast(msg) {
        toast.textContent = msg;
        toast.classList.add('is-show');
        setTimeout(function () { toast.classList.remove('is-show'); }, 3200);
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        var name = form.name.value.trim();
        var text = form.text.value.trim();
        if (!name || !text) return;
        var today = new Date();
        var dd = ('0' + today.getDate()).slice(-2);
        var mm = ('0' + (today.getMonth() + 1)).slice(-2);
        var review = { n: name, d: dd + '/' + mm + '/' + today.getFullYear(), t: text, r: chosen, _ts: today.getTime() };
        reviews.unshift(review);
        shown = perPage;
        if (sortEl) sortEl.value = 'recent';
        render();
        form.reset();
        chosen = 5; drawPicker();
        closeModal();
        showToast('Grazie! La tua recensione è stata inviata.');
        listEl.scrollIntoView({ behavior: 'smooth', block: 'start' });
      });
    }
  }

  function boot() {
    document.querySelectorAll('.uni-rev').forEach(function (root) {
      if (root.dataset.uniInit) return;
      root.dataset.uniInit = '1';
      initSection(root);
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot);
  } else {
    boot();
  }
  // Re-init when added/edited in the Shopify theme editor.
  document.addEventListener('shopify:section:load', boot);
})();
</script>
