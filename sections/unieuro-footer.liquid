<style>
  #shopify-section-{{ section.id }} .footer-srv {
    background: {{ section.settings.bg_color }};
    color: {{ section.settings.text_color }};
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    font-size: 14px;
    line-height: 1.6;
    box-sizing: border-box;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    padding: 80px 60px 40px;
  }
  #shopify-section-{{ section.id }} .footer-srv * { box-sizing: border-box; }
  #shopify-section-{{ section.id }} .footer-srv__inner {
    max-width: 1400px;
    margin: 0 auto;
  }
  #shopify-section-{{ section.id }} .footer-srv__grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr 1fr 1fr;
    gap: 60px;
    margin-bottom: 60px;
  }
  #shopify-section-{{ section.id }} .footer-srv__brand-name {
    font-family: 'Playfair Display', Georgia, serif;
    font-size: 38px;
    font-weight: 400;
    letter-spacing: 0.5px;
    margin: 0 0 24px;
    color: {{ section.settings.text_color }};
  }
  #shopify-section-{{ section.id }} .footer-srv__subtitle {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    margin: 0 0 16px;
    opacity: 0.85;
  }
  #shopify-section-{{ section.id }} .footer-srv__address {
    font-style: italic;
    margin: 0 0 6px;
    opacity: 0.95;
  }
  #shopify-section-{{ section.id }} .footer-srv__phone {
    font-style: italic;
    margin: 18px 0 30px;
    opacity: 0.95;
  }
  #shopify-section-{{ section.id }} .footer-srv__socials {
    display: flex;
    gap: 18px;
    align-items: center;
  }
  #shopify-section-{{ section.id }} .footer-srv__socials a {
    color: {{ section.settings.text_color }};
    transition: opacity 0.2s ease;
    display: inline-flex;
  }
  #shopify-section-{{ section.id }} .footer-srv__socials a:hover { opacity: 0.7; }
  #shopify-section-{{ section.id }} .footer-srv__socials svg {
    width: 22px;
    height: 22px;
    fill: currentColor;
  }
  #shopify-section-{{ section.id }} .footer-srv__heading {
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 2.5px;
    text-transform: uppercase;
    margin: 0 0 28px;
    opacity: 0.85;
  }
  #shopify-section-{{ section.id }} .footer-srv__hours {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px 40px;
  }
  #shopify-section-{{ section.id }} .footer-srv__hours-day { font-weight: 600; }
  #shopify-section-{{ section.id }} .footer-srv__hours-time { opacity: 0.95; }
  #shopify-section-{{ section.id }} .footer-srv__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  #shopify-section-{{ section.id }} .footer-srv__list li { margin-bottom: 14px; }
  #shopify-section-{{ section.id }} .footer-srv__list a {
    color: {{ section.settings.text_color }};
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: opacity 0.2s ease;
  }
  #shopify-section-{{ section.id }} .footer-srv__list a:hover { opacity: 0.7; }
  #shopify-section-{{ section.id }} .footer-srv__bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    padding-top: 20px;
    gap: 30px;
  }
  #shopify-section-{{ section.id }} .footer-srv__logo {
    width: 110px;
    height: auto;
    display: block;
  }
  #shopify-section-{{ section.id }} .footer-srv__legal {
    display: flex;
    gap: 32px;
  }
  #shopify-section-{{ section.id }} .footer-srv__legal a {
    color: {{ section.settings.text_color }};
    text-decoration: underline;
    text-underline-offset: 3px;
    font-size: 13px;
  }
  #shopify-section-{{ section.id }} .footer-srv__legal a:hover { opacity: 0.7; }
  @media (max-width: 990px) {
    #shopify-section-{{ section.id }} .footer-srv {
      padding: 60px 30px 30px;
    }
    #shopify-section-{{ section.id }} .footer-srv__grid {
      grid-template-columns: 1fr 1fr;
      gap: 40px 30px;
    }
    #shopify-section-{{ section.id }} .footer-srv__bottom {
      flex-direction: column;
      align-items: flex-start;
      gap: 30px;
    }
  }
  @media (max-width: 600px) {
    #shopify-section-{{ section.id }} .footer-srv__grid { grid-template-columns: 1fr; }
    #shopify-section-{{ section.id }} .footer-srv__brand-name { font-size: 32px; }
    #shopify-section-{{ section.id }} .footer-srv__legal { flex-direction: column; gap: 12px; }
    #shopify-section-{{ section.id }} .footer-srv__logo { width: 90px; }
  }
</style>

<footer class="footer-srv">
  <div class="footer-srv__inner">
    <div class="footer-srv__grid">

      <div>
        <h2 class="footer-srv__brand-name">{{ section.settings.brand_name }}</h2>
        {%- if section.settings.subtitle != blank -%}
          <p class="footer-srv__subtitle">{{ section.settings.subtitle }}</p>
        {%- endif -%}
        {%- if section.settings.address_1 != blank -%}
          <p class="footer-srv__address">{{ section.settings.address_1 }}</p>
        {%- endif -%}
        {%- if section.settings.address_2 != blank -%}
          <p class="footer-srv__address">{{ section.settings.address_2 }}</p>
        {%- endif -%}
        {%- if section.settings.phone != blank -%}
          <p class="footer-srv__phone">{{ section.settings.phone }}</p>
        {%- endif -%}

        <div class="footer-srv__socials">
          {%- if section.settings.whatsapp_url != blank -%}
            <a href="{{ section.settings.whatsapp_url }}" target="_blank" rel="noopener" aria-label="WhatsApp">
              <svg viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.facebook_url != blank -%}
            <a href="{{ section.settings.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook">
              <svg viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.instagram_url != blank -%}
            <a href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram">
              <svg viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
            </a>
          {%- endif -%}
          {%- if section.settings.tripadvisor_url != blank -%}
            <a href="{{ section.settings.tripadvisor_url }}" target="_blank" rel="noopener" aria-label="Tripadvisor">
              <svg viewBox="0 0 24 24"><path d="M12.006 4.295c-2.67 0-5.338.784-7.645 2.353H0l1.963 2.135a5.997 5.997 0 0 0 4.04 10.43 5.976 5.976 0 0 0 4.075-1.6L12 19.705l1.922-2.09a5.972 5.972 0 0 0 4.072 1.598 6 6 0 0 0 6-5.998 5.982 5.982 0 0 0-1.957-4.432L24 6.648h-4.36a13.499 13.499 0 0 0-7.633-2.353zM6.003 8.255a4.965 4.965 0 0 1 4.961 4.96 4.965 4.965 0 0 1-4.96 4.962 4.965 4.965 0 0 1-4.962-4.961 4.965 4.965 0 0 1 4.961-4.961zm11.992 0a4.965 4.965 0 0 1 4.961 4.96 4.965 4.965 0 0 1-4.96 4.962 4.965 4.965 0 0 1-4.962-4.961 4.965 4.965 0 0 1 4.961-4.961zM6.003 11.443a1.78 1.78 0 0 1 1.778 1.778 1.78 1.78 0 0 1-1.778 1.778 1.78 1.78 0 0 1-1.778-1.778 1.78 1.78 0 0 1 1.778-1.778zm11.992 0a1.78 1.78 0 0 1 1.778 1.778 1.78 1.78 0 0 1-1.778 1.778 1.78 1.78 0 0 1-1.778-1.778 1.78 1.78 0 0 1 1.778-1.778z"/></svg>
            </a>
          {%- endif -%}
        </div>
      </div>

      {%- if section.settings.show_hours -%}
        <div>
          <p class="footer-srv__heading">{{ section.settings.hours_heading }}</p>
          <div class="footer-srv__hours">
            <span class="footer-srv__hours-day">{{ section.settings.day_1 }}</span><span class="footer-srv__hours-time">{{ section.settings.time_1 }}</span>
            <span class="footer-srv__hours-day">{{ section.settings.day_2 }}</span><span class="footer-srv__hours-time">{{ section.settings.time_2 }}</span>
            <span class="footer-srv__hours-day">{{ section.settings.day_3 }}</span><span class="footer-srv__hours-time">{{ section.settings.time_3 }}</span>
            <span class="footer-srv__hours-day">{{ section.settings.day_4 }}</span><span class="footer-srv__hours-time">{{ section.settings.time_4 }}</span>
            <span class="footer-srv__hours-day">{{ section.settings.day_5 }}</span><span class="footer-srv__hours-time">{{ section.settings.time_5 }}</span>
            <span class="footer-srv__hours-day">{{ section.settings.day_6 }}</span><span class="footer-srv__hours-time">{{ section.settings.time_6 }}</span>
            <span class="footer-srv__hours-day">{{ section.settings.day_7 }}</span><span class="footer-srv__hours-time">{{ section.settings.time_7 }}</span>
          </div>
        </div>
      {%- endif -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'link_column' -%}
          <div {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <p class="footer-srv__heading">{{ block.settings.heading }}</p>
            {%- endif -%}
            <ul class="footer-srv__list">
              {%- for i in (1..6) -%}
                {%- assign label_key = 'link_' | append: i | append: '_label' -%}
                {%- assign url_key = 'link_' | append: i | append: '_url' -%}
                {%- assign label = block.settings[label_key] -%}
                {%- assign url = block.settings[url_key] -%}
                {%- if label != blank -%}
                  <li><a href="{{ url | default: '#' }}">{{ label }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}

    </div>

    <div class="footer-srv__bottom">
      {%- if section.settings.logo != blank -%}
        <img src="{{ section.settings.logo | image_url: width: 220 }}" alt="{{ section.settings.brand_name | escape }}" class="footer-srv__logo" width="110" loading="lazy">
      {%- else -%}
        <span class="footer-srv__logo" style="width:auto;font-family:'Playfair Display',Georgia,serif;font-size:22px;">{{ section.settings.brand_name }}</span>
      {%- endif -%}
      <div class="footer-srv__legal">
        {%- for block in section.blocks -%}
          {%- if block.type == 'legal_link' and block.settings.label != blank -%}
            <a href="{{ block.settings.url | default: '#' }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</footer>

