    "review_carousel_EJ8GbG": {
      "type": "review-carousel",
      "blocks": {
        "review_Udt7MB": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-2ebeb3fb4c0e69b043273cfc0ac33b49-preview-sgmConversionBaseFormat-sgmSearchFormat.jpg",
            "review_text": "Aspira e lava davvero in una sola passata, i pavimenti si asciugano in fretta. Comodissimo l'autopulente: premo un tasto e si sistema da solo.",
            "reviewer_name": "Federica"
          }
        },
        "review_4KdHEk": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-61260161b6b5a17de0237ff5963d9d13-preview-sgmConversionBaseFormat.jpg",
            "review_text": "Leggero e potente, l'autonomia basta per tutta la casa. Il serbatoio si svuota al volo e senza sacchetti si risparmia.",
            "reviewer_name": "Marco"
          }
        },
        "review_Q3wgkB": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-45aa022adbda3c7d3e38ceaf3bdf4ca0-preview-sgmConversionBaseFormat.jpg",
            "review_text": "Gli accessori inclusi sono tanti e utili, uso la bocchetta piccola per il divano e l'auto. Consegna veloce e prodotto imballato benissimo.",
            "reviewer_name": "Alessia"
          }
        },
        "review_44MHtp": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-c615c2f597b6ab35bc071abeccc74571-preview-sgmConversionBaseFormat.jpg",
            "review_text": "Si piega e passa sotto il letto senza doversi inginocchiare, una svolta. Niente più capelli attorcigliati nella spazzola.",
            "reviewer_name": "Giovanna"
          }
        },
        "review_8Pmj3A": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-e09416d293453b80b9c666b15eff7796-preview-sgmConversionBaseFormat-sgmThumbFormat.jpg",
            "review_text": "Ottimo acquisto, la modalità lavaggio toglie anche le macchie secche. Dopo un mese di uso quotidiano funziona perfettamente.",
            "reviewer_name": "Luca"
          }
        },
        "review_j3QcfJ": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-61260161b6b5a17de0237ff5963d9d13-preview-sgmConversionBaseFormat.jpg",
            "review_text": "Sostituisce aspirapolvere e mocio, guadagno tempo tutti i giorni. Arrivato in tre giorni, tutto perfetto.",
            "reviewer_name": "Stefania"
          }
        }
      },
