        "collapsible_text_XWDpG9": {
          "type": "collapsible_text",
          "settings": {
            "title": "Autenticità",
            "content": "<p>Garantiamo che ogni articolo ricevuto sia 100% autentico e nuovo di fabbrica. Ogni prodotto viene attentamente ispezionato dal nostro team per assicurarci che soddisfi gli elevati standard di qualità su cui ci impegniamo.</p>",
            "page": ""
          }
        },
        "collapsible_text_Cw8yU9": {
          "type": "collapsible_text",
          "settings": {
            "title": "Spedizione & Resi",
            "content": "<p><strong>Tempi di lavorazione:</strong></p><ul><li><strong>24 ore:</strong> Gli ordini effettuati prima delle 17:00 vengono spediti entro 24 ore nei giorni lavorativi.</li><li><strong>Spedizione:</strong> La consegna avviene entro 3–5 giorni lavorativi con corriere espresso e tracciamento.</li></ul><p>Puoi richiedere un reso entro 30 giorni dalla ricezione del tuo ordine.</p>",
            "page": ""
          }
        }
