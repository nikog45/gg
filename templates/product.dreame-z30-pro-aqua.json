            "column_2_heading": "Spazzola TangleCut™",
            "column_2_description": "<p>La spazzola multisuperficie evita i grovigli di capelli e peli su qualsiasi pavimento</p>",
            "column_3_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-c615c2f597b6ab35bc071abeccc74571-preview-sgmConversionBaseFormat.jpg",
