            "review_text": "Il lavaggio è sorprendente, toglie anche le impronte del cane in cucina. Aspirazione potentissima sui tappeti.",
            "reviewer_name": "Chiara"
          }
        },
        "review_Q3wgkB": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-c01c07f3283af1bf6da7f056f8579505-preview-sgmConversionBaseFormat.jpg",
            "review_text": "La base che asciuga i moci con aria calda evita i cattivi odori, differenza enorme rispetto al robot che avevo prima.",
            "reviewer_name": "Andrea"
          }
        },
        "review_44MHtp": {
          "type": "review",
          "settings": {
