      "blocks": {
        "review_Udt7MB": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-a28adad072877c2ad6a6211924a25f9e-preview-sgmConversionBaseFormat-sgmSearchFormat.jpg",
            "review_text": "Lo avvio dall'app quando esco e torno a casa con i pavimenti puliti e i moci già lavati e asciutti. La stazione fa davvero tutto da sola.",
            "reviewer_name": "Paolo"
          }
        },
        "review_4KdHEk": {
          "type": "review",
          "settings": {
