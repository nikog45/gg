    "review_carousel_EJ8GbG": {
      "type": "review-carousel",
      "blocks": {
        "review_Udt7MB": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-d5573e25e02a4b15e1cf724697f46579-preview-sgmConversionBaseFormat-sgmProductFormat.jpg",
            "review_text": "Stiro in metà tempo rispetto al ferro tradizionale, il vapore è potentissimo. Le camicie vengono perfette.",
            "reviewer_name": "Rosanna"
          }
        },
        "review_4KdHEk": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-d7b9842cad1266873c575e7aca21df0e-preview-sgmConversionBaseFormat.jpg",
            "review_text": "Compatta per essere una caldaia, sta comoda nel mobile. Si scalda in fretta ed è pronta subito.",
            "reviewer_name": "Claudio"
          }
        },
        "review_Q3wgkB": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-eaaba7ae8648c690bf8a29e27c10ac11-preview-sgmConversionBaseFormat.jpg",
            "review_text": "Il colpo di vapore toglie le pieghe anche dai jeans in una passata. Serbatoio comodo da riempire.",
            "reviewer_name": "Patrizia"
          }
        },
        "review_44MHtp": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-20b27b42f08486855d74bc45d6140c2d-preview-sgmConversionBaseFormat.jpg",
            "review_text": "La piastra scivola benissimo e non si attacca ai tessuti delicati. Ottimo acquisto.",
            "reviewer_name": "Sandra"
          }
        },
        "review_8Pmj3A": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-5886cc1f8a06b07e140fc5fd23756636-preview-sgmConversionBaseFormat.jpg",
            "review_text": "Vapore uniforme su tutta la piastra, si nota la differenza. Arrivata in due giorni.",
            "reviewer_name": "Enrico"
          }
        },
        "review_j3QcfJ": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-754cc57af537922423649f67a26485ca-preview-sgmConversionBaseFormat.jpg",
            "review_text": "La uso anche in verticale sulle tende, funziona davvero. Silenziosa e ben fatta.",
