    "review_carousel_EJ8GbG": {
      "type": "review-carousel",
      "blocks": {
        "review_Udt7MB": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-0655fed47e634d708629901ee97c91c3-preview-sgmConversionBaseFormat-sgmProductFormat.jpg",
            "review_text": "La uso tutti i giorni per andare al lavoro, 12 km senza fatica e senza sudare. Comoda e stabile anche col pavé.",
            "reviewer_name": "Giorgio"
          }
        },
        "review_4KdHEk": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-49a7b964ffe66c82298e7275ef5a660d-preview-sgmConversionBaseFormat.jpg",
            "review_text": "Montaggio semplice, era quasi tutta assemblata. La pedalata assistita spinge bene in salita.",
            "reviewer_name": "Serena"
          }
        },
        "review_Q3wgkB": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-def92743a35361aaca61062ec03b84bf-preview-sgmConversionBaseFormat.jpg",
            "review_text": "Bella solida, si sente la qualità del telaio. La batteria dura davvero tanto, la ricarico due volte a settimana.",
            "reviewer_name": "Antonio"
          }
        },
        "review_44MHtp": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-757b5dafa9a7cb2718d3ddc94208e3d0-preview-sgmConversionBaseFormat.jpg",
            "review_text": "Perfetta per la città, comoda la posizione di guida dritta. Arrivata prima del previsto.",
            "reviewer_name": "Lucia"
          }
        },
        "review_8Pmj3A": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-5275bdd300c781a552d28fe0a671ef16-preview-sgmConversionBaseFormat.jpg",
            "review_text": "Ottimo rapporto qualità prezzo per una e-bike. Freni e cambio funzionano bene fin da subito.",
            "reviewer_name": "Piero"
          }
        },
        "review_j3QcfJ": {
          "type": "review",
          "settings": {
            "review_image": "shopify://shop_images/api-rest-00ed29448a7522f610cac04d7b9ea7e0-assets-b183b23abcf7b7f04adfa8acd7f6354a-preview-sgmConversionBaseFormat.jpg",
            "review_text": "Regalata a mia moglie, ora la usa più lei dell'auto. Consigliata a chi si muove in città.",
            "reviewer_name": "Massimo"
          }
        }
      },
